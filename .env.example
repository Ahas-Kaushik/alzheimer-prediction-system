BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# ── Neo4j knowledge graph ────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_min_8_chars
# Neo4j Community only supports the default database name "neo4j".
NEO4J_DATABASE=neo4j

# Storage routing: "neo4j" (preferred) or "csv". Fallback to CSV if Neo4j down.
GRAPH_BACKEND=neo4j
ALLOW_CSV_FALLBACK=True
USE_CSV_FALLBACK=False

# ── RAG / vector storage (local, no API key needed) ──────────────────────
ENABLE_RAG=True
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
VECTOR_INDEX_NAME=clinical_chunks
RAG_TOP_K=4

# ── LLM (Google Gemini) ──────────────────────────────────────────────────
# Leave GEMINI_API_KEY empty to use deterministic templated reasoning.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Models / uploads ─────────────────────────────────────────────────────
GAN_CHECKPOINT_PATH=data/checkpoints/gan_generator.pth
CLASSIFIER_CHECKPOINT_PATH=data/checkpoints/classifier.pth
UPLOAD_DIR=backend/uploads
VITE_API_BASE_URL=http://localhost:8000/api
